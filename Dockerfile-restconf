# sysrepo
RUN \
      cd /opt/dev && \
      git clone https://github.com/sysrepo/sysrepo.git -b v3.7.11 && cd sysrepo && \
      mkdir build && cd build && \
      cmake -DENABLE_TESTS=OFF -DCMAKE_BUILD_TYPE="Release" -DCMAKE_INSTALL_PREFIX:PATH=/usr -DREPOSITORY_LOC:PATH=/etc/sysrepo .. && \
      make -j8 && \
      make install

#sysrepo-cpp
RUN \
    cd /opt/dev && git clone https://github.com/macauleycheng/sysrepo-cpp.git -b fixBuildError && cd sysrepo-cpp && \
    mkdir build && cd build && \
    cmake  -DBUILD_TESTING=OFF .. && make && make install

#nghttp2-asio
RUN \
    cd /opt/dev && git clone https://github.com/nghttp2/nghttp2-asio.git && cd nghttp2-asio && \
    mkdir build && cd build && \
    cmake .. && make && make install

