#patch libpam.pc
RUN \
echo " \
exec_prefix=${prefix} \n\ 
libdir=/usr/lib/x86_64- linux-gnu \n\
includedir=/usr/include/security  \n\
\n\
Name: PAM  \n\
Description: The primary Linux-PAM library. It is used by PAM modules and PAM-aware applications. \n\
URL: http://www.linux-pam.org/ \n\
Version: 1.4.0 \n\ 
Cflags: -I${includedir} \n\ 
Libs: -L${libdir} -lpam \n\ 
" > /usr/lib/x86_64-linux-gnu/pkgconfig/pam.pc

#patch libdocopt.pc
RUN \
echo " \
prefix=/usr \n\
exec_prefix=${prefix}  \n\
libdir=/usr/lib/x86_64-linux-gnu   \n\
includedir=/usr/include/docopt/  \n\
\n\
Name: DOCOPT  \n\
Description: DOCOPT  \n\ 
URL:   \n\
Version: 0.6.2   \n\
Cflags: -I${includedir}  \n\
Libs: -L${libdir} -ldocopt  \n\
" > /usr/lib/x86_64-linux-gnu/pkgconfig/docopt.pc

RUN \
   cd /opt/dev/ &&  git clone https://github.com/macauleycheng/rousette.git -b fixBuildFail  && cd rousette && \
   mkdir build && cd build && \
   cmake  -DBUILD_TESTING=OFF .. && make && make install

