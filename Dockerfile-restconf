FROM ubuntu:22.04

RUN \
    apt-get update && apt-get install -y \
    git cmake valgrind libpcre2-dev build-essential pkg-config \
    vim libboost-dev libboost-system-dev libboost-thread-dev \
    libnghttp2-dev libssl-dev libspdlog-dev libsystemd-dev libpam0g-dev libdocopt-dev\
    bison byacc flex libcurlpp-dev

RUN mkdir /opt/dev 

#libyang
RUN cd /opt/dev && \
      git clone https://github.com/CESNET/libyang.git -b v3.13.6 && cd libyang && \
      mkdir build && cd build && \
      cmake -DCMAKE_BUILD_TYPE:String="Release" -DCMAKE_INSTALL_PREFIX:PATH=/usr -DENABLE_BUILD_TESTS=OFF .. && \
      make -j8 && \
      make install

#date
RUN \
    cd /opt/dev && git clone https://github.com/HowardHinnant/date.git -b v3.0.4 && cd date && \
    mkdir build && cd build && \
    cmake -DBUILD_TZ_LIB=ON .. && make && make install

#doctest
RUN \
    cd /opt/dev && git clone https://github.com/doctest/doctest.git -b v2.4.11 && cd doctest && \
    mkdir build && cd build && \
    cmake .. && make && make install

#libyang-cpp
RUN \
     cd /opt/dev && git clone https://github.com/macauleycheng/libyang-cpp.git -b fixDate && cd libyang-cpp && \
     mkdir build && cd build && \
     cmake -DBUILD_TESTING=OFF .. && make && make install

